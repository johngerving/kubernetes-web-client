package templates

type page struct {
    name string
    href templ.SafeURL 
}

var pages = [...]page {
    {
        name: "Home",
        href: "/home",
    },
    {
        name: "Upload",
        href: "/upload",
    },
}

templ Sidebar(currentHref templ.SafeURL) {
    <div class="w-72 p-6 border-r border-slate-300">
        <ul class="flex flex-col gap-2 text-xl">
            for _, page := range pages {
                <li>
                    <a href={page.href} preload="mouseover" class={"transition-all hover:text-blue-500/75", templ.KV("hover:text-blue-500/100 text-blue-500", currentHref == page.href)}>
                        <p>{page.name}</p>
                    </a>
                </li>
            }
        </ul>
    </div>
}